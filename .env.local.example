# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# The URL + anon key are safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key with full DB access — bypasses Row-Level Security.
# NEVER expose this to the browser. Used only by the seed script / server routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where OAuth / email links redirect back to. Use your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Razorpay (payments) ─────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use TEST keys (rzp_test_…) until launch.
# The key id is shown to the browser to open Checkout; the secret never is.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard → Webhooks → add https://<your-site>/api/razorpay/webhook, set a secret, paste it here.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Dashboard → Subscriptions → Plans: create one monthly plan per tier, paste the plan_… ids.
RAZORPAY_PLAN_PRO=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_CAREER=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_INTERVIEW=plan_xxxxxxxxxxxxxx
