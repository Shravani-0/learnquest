# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# The URL + anon key are safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key with full DB access — bypasses Row-Level Security.
# NEVER expose this to the browser. Used only by the seed script / server routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where OAuth / email links redirect back to. Use your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
